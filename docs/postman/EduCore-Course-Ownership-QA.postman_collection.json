{
  "info": {
    "name": "EduCore: Course API Ownership QA",
    "description": "Two-user ownership tests for the EduCore Course API.\n\nHow to run: set the collection variable `baseUrl` (local: http://localhost:5000, live: your Render URL), then run the whole collection in order with the Collection Runner. Folder 0 registers two fresh users (A and B) every run and stores their tokens; the rest only uses those tokens.\n\nEvery request has test scripts, so a green run means every expected status and message matched.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Passw0rd!123",
      "type": "string"
    },
    {
      "key": "missingId",
      "value": "64b000000000000000000000",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "userIdA",
      "value": "",
      "type": "string"
    },
    {
      "key": "userIdB",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "spoofCourseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseTitle",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup: two users",
      "item": [
        {
          "name": "0.1 Health check + new run id",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh run id makes every run register brand-new users (no 409 on re-runs)",
                  "pm.collectionVariables.set('runId', Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Server reports ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Run the whole collection in order (Runner), or at least this folder first.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "0.2 Register user A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns a token and user\", () => { pm.expect(json.token).to.be.a(\"string\"); pm.expect(json.user.email).to.include(\"qa.a.\"); });",
                  "pm.test(\"No password in the response\", () => pm.expect(JSON.stringify(json)).to.not.include(\"password\"));",
                  "pm.collectionVariables.set('tokenA', json.token);",
                  "pm.collectionVariables.set('userIdA', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA User A\",\n  \"email\": \"qa.a.{{runId}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"instructor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "0.3 Register user B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Returns a token and user\", () => { pm.expect(json.token).to.be.a(\"string\"); pm.expect(json.user.email).to.include(\"qa.b.\"); });",
                  "pm.test(\"User B is a different user from A\", () => pm.expect(json.user.id).to.not.eql(pm.collectionVariables.get('userIdA')));",
                  "pm.collectionVariables.set('tokenB', json.token);",
                  "pm.collectionVariables.set('userIdB', json.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA User B\",\n  \"email\": \"qa.b.{{runId}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"instructor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1. Token checks -> 401",
      "item": [
        {
          "name": "1.1 No token: POST /api/courses -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Code is NO_TOKEN\", () => pm.expect(pm.response.json().code).to.eql(\"NO_TOKEN\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA Course: Ownership 101\",\n  \"description\": \"Course created by the ownership QA collection.\",\n  \"category\": \"Testing\",\n  \"thumbnailUrl\": \"https://example.com/qa.png\",\n  \"published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.2 Garbage token: GET /api/courses -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Code is MALFORMED_TOKEN\", () => pm.expect(pm.response.json().code).to.eql(\"MALFORMED_TOKEN\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not.a.real.token",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Create and read (user A)",
      "item": [
        {
          "name": "2.1 User A creates a course -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const course = pm.response.json().course;",
                  "pm.collectionVariables.set('courseId', course._id);",
                  "pm.collectionVariables.set('courseTitle', course.title);",
                  "pm.test(\"authorId is user A (from the JWT)\", () => pm.expect(course.authorId._id).to.eql(pm.collectionVariables.get('userIdA')));",
                  "pm.test(\"Author name is populated\", () => pm.expect(course.authorId.name).to.eql(\"QA User A\"));",
                  "pm.test(\"Published flag stored\", () => pm.expect(course.published).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA Course: Ownership 101\",\n  \"description\": \"Course created by the ownership QA collection.\",\n  \"category\": \"Testing\",\n  \"thumbnailUrl\": \"https://example.com/qa.png\",\n  \"published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.2 Owner cannot be spoofed: A sends authorId = B -> 201, still A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const course = pm.response.json().course;",
                  "pm.collectionVariables.set('spoofCourseId', course._id);",
                  "pm.test(\"authorId ignored from body: still user A\", () => { pm.expect(course.authorId._id).to.eql(pm.collectionVariables.get('userIdA')); pm.expect(course.authorId._id).to.not.eql(pm.collectionVariables.get('userIdB')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA Spoof Attempt\",\n  \"description\": \"Course created by the ownership QA collection.\",\n  \"category\": \"Testing\",\n  \"thumbnailUrl\": \"https://example.com/qa.png\",\n  \"published\": true,\n  \"authorId\": \"{{userIdB}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.3 User A lists /mine and sees the course -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const courses = pm.response.json().courses;",
                  "pm.test(\"/mine contains A's new course\", () => pm.expect(courses.map(c => c._id)).to.include(pm.collectionVariables.get('courseId')));",
                  "pm.test(\"Every course in /mine belongs to A\", () => courses.forEach(c => pm.expect(c.authorId._id).to.eql(pm.collectionVariables.get('userIdA'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "mine"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "2.4 User B lists /mine and does NOT see A's course -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const courses = pm.response.json().courses;",
                  "pm.test(\"A's course is not in B's /mine\", () => pm.expect(courses.map(c => c._id)).to.not.include(pm.collectionVariables.get('courseId')));",
                  "pm.test(\"Everything in B's /mine belongs to B\", () => courses.forEach(c => pm.expect(c.authorId._id).to.eql(pm.collectionVariables.get('userIdB'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "mine"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Ownership: user B attacks A's course -> 403",
      "item": [
        {
          "name": "3.1 User B tries PUT on A's course -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));",
                  "const json = pm.response.json();",
                  "pm.test(\"Message is exact\", () => pm.expect(json.message).to.eql(\"Not authorized to modify this course\"));",
                  "pm.test(\"Code is FORBIDDEN\", () => pm.expect(json.code).to.eql(\"FORBIDDEN\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hijacked by B\",\n  \"description\": \"B should not be able to do this.\",\n  \"category\": \"Hacking\",\n  \"published\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3.2 User B tries DELETE on A's course -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"Message is exact\", () => pm.expect(pm.response.json().message).to.eql(\"Not authorized to modify this course\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "3.3 Proof nothing changed: A fetches the course -> 200, original title",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Course still exists with the original title\", () => pm.expect(pm.response.json().course.title).to.eql(pm.collectionVariables.get('courseTitle')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenA}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
