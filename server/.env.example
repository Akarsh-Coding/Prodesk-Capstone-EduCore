PORT=5000
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/educore?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# Stripe, TEST MODE ONLY (keys start with sk_test_). Never commit a real key or use a live key.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
# Where Stripe sends the user after checkout (your frontend, no trailing slash)
FRONTEND_URL=http://localhost:3000

# Google Gemini for POST /api/ai/suggest. SERVER-SIDE ONLY: never put this key in the client or commit it.
# Create a key in Google AI Studio and use a model name that your key can access.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Optional: give up on the AI call after this many milliseconds (default 25000)
GEMINI_TIMEOUT_MS=25000

# Optional rate-limit overrides. The defaults (shown) are the production values: leave these commented out.
# For a demo, uncomment and lower them, restart the server, and remove them again afterwards.
# RATE_LIMIT_AUTH_MAX=20       failed logins (and registrations) allowed per IP per window
# RATE_LIMIT_AI_MAX=5          AI quiz requests allowed per user per window
# RATE_LIMIT_WINDOW_MS=900000  the window: 15 minutes

