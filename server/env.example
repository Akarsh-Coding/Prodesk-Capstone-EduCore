PORT=5000
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/educore?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# Stripe, TEST MODE ONLY (keys start with sk_test_). Never commit a real key or use a live key.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
# Where Stripe sends the user after checkout (your frontend, no trailing slash)
FRONTEND_URL=http://localhost:3000
